# Copy to .env and fill in.

# Anthropic API key for the Ask/Chat layer.
ANTHROPIC_API_KEY=

# Optional: FinancialModelingPrep key, used by FinanceToolkit for statements.
FMP_API_KEY=

# Telegram bot for daily reports.
# Create a bot via @BotFather in Telegram, then message your bot once and
# fetch your chat_id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: fallback email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=

# Logging
LOG_LEVEL=INFO
